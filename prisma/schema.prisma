generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  phone         String?  @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  language      String   @default("en")
  role          String   @default("user")
  village       String?
  district      String?
  state         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  farms           Farm[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Farm {
  id            String   @id @default(cuid())
  userId        String
  name          String
  latitude      Float?
  longitude     Float?
  village       String?
  district      String?
  state         String?
  country       String   @default("India")
  area          Float
  areaUnit      String   @default("acre")
  irrigationType String  @default("rainfed")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  soilReports   SoilReport[]
  recommendations Recommendation[]
}

model SoilReport {
  id              String   @id @default(cuid())
  farmId          String
  fileUrl         String?
  testDate        DateTime?
  ph              Float?
  ec              Float?
  organicCarbon   Float?
  nitrogen        Float?
  phosphorus      Float?
  potassium       Float?
  sulphur         Float?
  zinc            Float?
  iron            Float?
  boron           Float?
  manganese       Float?
  copper          Float?
  rawExtractedData String?
  createdAt       DateTime @default(now())

  farm            Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
}

model Crop {
  id              String   @id @default(cuid())
  name            String
  nameHi          String?
  nameOr          String?
  scientificName  String?
  category        String
  season          String
  regions         String
  phMin           Float
  phMax           Float
  tempMin         Float
  tempMax         Float
  rainfallMin     Float
  rainfallMax     Float
  irrigationNeeded Boolean @default(false)
  duration        Int
  waterRequirement String   @default("medium")
  description     String?
  descriptionHi   String?
  descriptionOr   String?
  createdAt       DateTime @default(now())

  fertilizerRules FertilizerRule[]
  recommendations Recommendation[]
}

model FertilizerRule {
  id                String   @id @default(cuid())
  cropId            String
  region            String   @default("all")
  soilNStatus       String   @default("medium")
  soilPStatus       String   @default("medium")
  soilKStatus       String   @default("medium")
  targetYield       Float?
  nitrogenPerAcre   Float
  phosphorusPerAcre Float
  potassiumPerAcre  Float
  sulphurPerAcre    Float    @default(0)
  applicationStage  String
  source            String   @default("ICAR")
  version           String   @default("2024")
  notes             String?
  createdAt         DateTime @default(now())

  crop              Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
}

model AlertRule {
  id          String   @id @default(cuid())
  type        String
  threshold   Float
  unit        String
  messageEn   String
  messageHi   String
  messageOr   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Recommendation {
  id            String   @id @default(cuid())
  farmId        String
  soilReportId  String?
  cropId        String?
  score         Float?
  reasoning     String?
  fertilizerPlan String?
  weatherData   String?
  farmDetails   String?
  createdAt     DateTime @default(now())

  farm          Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  soilReport    SoilReport? @relation(fields: [soilReportId], references: [id])
  crop          Crop?       @relation(fields: [cropId], references: [id])
}
